# Lokální proměnné pro `pnpm preview` (wrangler dev). Zkopírujte do .dev.vars (je v .gitignore).
# Adresa iCal exportu obsazenosti. Pro vývoj použijte syntetický .ics soubor,
# soukromý export z e-chalup sem nepatří (v Cloudflare je uložený jako secret).
ECHALUPY_ICAL_URL=

# Rezervační POST /api/reservations (lokálně nad lokální D1, nikdy nad produkční).
# Lokální databázi označte: npx wrangler d1 execute chalupa-vsetice-rezervace --local \
#   --command "INSERT INTO meta (key, value) VALUES ('environment', 'local')"
BOOKING_ENV=local
BOOKING_API_ENABLED=true
# Volitelný Bearer token (jen neveřejné prostředí). Prázdný = nevyžaduje se.
BOOKING_API_TOKEN=
# Turnstile: lokálně testovací secret Cloudflare (vždy projde) s tokenem XXXX.DUMMY.TOKEN.XXXX.
# Produkce testovací secret odmítne.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upozornění správci na kolize rezervací (Cron, worker/booking/cron.ts). V Cloudflare jako secrets.
RESEND_API_KEY=
CONFLICT_ALERT_EMAIL=
# Doporučený produkční odesílatel (interní adresa pro alerty): Chalupa Všetice <admin@chalupavsetice.cz>
CONFLICT_ALERT_FROM=
