{
  "name": "chalupa-vsetice-web",
  // Worker obsluhuje jen /api/* (/api/availability, /api/reservations, /api/reservations.ics);
  // vše ostatní jsou statické assety.
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    // Static output of `pnpm run build` (vinext prerender + scripts/finalize-static.mjs)
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Secret ECHALUPY_ICAL_URL se nastavuje v Cloudflare (wrangler secret put), nikdy v repozitáři.
  // Produkce: rezervační POST zůstává vypnutý.
  // Výstupní iCal /api/reservations.ics je zapnutý a chráněný BOOKING_ICAL_EXPORT_TOKEN.
  // Detekce kolizí rezervací a e-mailové upozornění správci (worker/booking/cron.ts) každých 5 minut.
  // Secrets RESEND_API_KEY a CONFLICT_ALERT_EMAIL (volitelně CONFLICT_ALERT_FROM) se nastavují
  // přes wrangler secret put, nikdy zde.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Rate limit veřejného POST /api/reservations podle IP: 5 požadavků za 60 s v lokalitě Cloudflare.
  // Chrání proti spamu; dvojí rezervaci téže noci brání D1, ne tento limit.
  "ratelimits": [
    {
      "name": "BOOKING_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "BOOKING_ENV": "production",
    "BOOKING_ICAL_EXPORT_ENABLED": "true"
  },
  // Rezervační úložiště. Produkční a testovací databáze jsou oddělené; ID doplní správce
  // po vytvoření databází (npx wrangler d1 create …).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chalupa-vsetice-rezervace",
      "database_id": "08656b04-3ade-4a34-b9d3-94f7b8e154ef",
      "migrations_dir": "migrations"
    }
  ],
  // Worker Previews nedědí proměnné ani bindingy z produkce: mají vlastní testovací D1
  // a jen zde je zapnutý rezervační POST (Turnstile + rate limit, volitelně BOOKING_API_TOKEN) a výstupní iCal
  // (token BOOKING_ICAL_EXPORT_TOKEN v query stringu, skrytý přes redact_query_string).
  "previews": {
    "observability": {
      "redact_query_string": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    },
    // TURNSTILE_SITE_KEY je veřejný site key widgetu (ne secret): testovací Invisible klíč Cloudflare
    // (1x…BB, vždy projde, nic nezobrazuje), patří k testovacímu TURNSTILE_SECRET_KEY v Preview.
    // Frontend ho dostane z GET /api/booking-config. Produkce ho nemá – formulář se tam nenabízí.
    "vars": {
      "BOOKING_ENV": "preview",
      "BOOKING_API_ENABLED": "true",
      "BOOKING_ICAL_EXPORT_ENABLED": "true",
      "TURNSTILE_SITE_KEY": "1x00000000000000000000BB"
    },
    // Vlastní namespace, aby se Preview a produkce nepočítaly dohromady.
    "ratelimits": [
      {
        "name": "BOOKING_RATE_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "chalupa-vsetice-rezervace-test",
        "database_id": "b6269d5f-4705-4b4c-a52c-e5030a020605",
        "migrations_dir": "migrations"
      }
    ]
  },
  // Workers Logs: logují se jen volání Workeru, tedy /api/* (statické assety Worker nespouští).
  // Worker loguje jen druh události, nikdy osobní údaje, obsah požadavků ani adresu exportu.
  "observability": {
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
