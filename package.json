{
  "name": "chalupa-vsetice-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/finalize-static.mjs",
    "preview": "wrangler dev --config wrangler.jsonc",
    "deploy": "node scripts/d1-migrations.ts check production && wrangler deploy --config wrangler.jsonc",
    "deploy:preview": "node scripts/d1-migrations.ts check preview && wrangler preview --config wrangler.jsonc",
    "db:check:production": "node scripts/d1-migrations.ts check production",
    "db:check:preview": "node scripts/d1-migrations.ts check preview",
    "db:migrate:preview": "node scripts/d1-migrations.ts apply preview",
    "db:migrate:production": "node scripts/d1-migrations.ts apply production",
    "smoke": "node scripts/smoke.ts",
    "test": "node --test 'tests/*.test.ts'"
  },
  "dependencies": {
    "ical.js": "2.2.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "miniflare": "4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.142.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
